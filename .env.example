# Copy to `.env` (git-ignored) for docker compose. Never commit real values.

# --- SQL Server (development container) ---
# Must meet SQL Server complexity rules: 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Passw0rd
SQL_DATABASE=AfnoParcel
SQL_PORT=1433

# --- Authentication (REQUIRED) ---
# Secret used to sign JWT access tokens. There is intentionally NO default: the API refuses to start without it.
# Generate a random value (64+ characters) and paste it here. Never commit it, never reuse it across environments.
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#   Bash:       openssl rand -base64 48
JWT_SIGNING_KEY=

# --- First SuperAdmin (OPTIONAL) ---
# Leave both empty to create no admin. When BOTH are set, the API creates this SuperAdmin on startup if it does not exist.
# Choose your own strong password (10+ chars, upper + lower + digit). Remove the password from .env after first start.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# --- Host ports ---
API_PORT=5080
WEB_PORT=5173

# --- Frontend ---
VITE_APP_NAME=Afno Parcel

# --- Running the API outside Docker ---
# Prefer user-secrets (see README). Environment variables use `__` for nesting, e.g.:
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AfnoParcel;User Id=sa;Password=<password>;Encrypt=True;TrustServerCertificate=True
# Windows authentication against a local SQL Server Express instance (no password needed):
# ConnectionStrings__DefaultConnection=Server=<MACHINE>\SQLEXPRESS;Database=AfnoParcel;Trusted_Connection=True;TrustServerCertificate=True
