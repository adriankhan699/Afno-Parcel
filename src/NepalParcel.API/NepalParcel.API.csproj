<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- HTTP host: controllers, middleware, composition root. No business logic. -->
  <PropertyGroup>
    <RootNamespace>NepalParcel.API</RootNamespace>
    <UserSecretsId>nepalparcel-api-6f1c2b8e-4d7a-4e55-9b0b-2f3c9f6a1d10</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NepalParcel.Application\NepalParcel.Application.csproj" />
    <ProjectReference Include="..\NepalParcel.Infrastructure\NepalParcel.Infrastructure.csproj" />
    <ProjectReference Include="..\NepalParcel.Contracts\NepalParcel.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.InMemory" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
