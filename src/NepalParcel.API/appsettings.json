{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedReferenceData": false,
    "SeedNotificationTemplates": true,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "afno-parcel-api",
    "Audience": "afno-parcel-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "BookingPermitPerMinute": 30,
    "TrackingPermitPerMinute": 60,
    "TrackingOtpPermitPerMinute": 10,
    "WebhookPermitPerMinute": 600
  },
  "Hangfire": {
    "Mode": "SqlServer",
    "WorkerCount": 2,
    "SweepCron": "* * * * *",
    "DashboardEnabled": false
  },
  "Notifications": {
    "Enabled": true,
    "WhatsApp": {
      "Provider": "Mock",
      "NotifyReceivers": true,
      "ApiVersion": "v21.0",
      "BaseUrl": "https://graph.facebook.com",
      "TimeoutSeconds": 15
    },
    "Sms": {
      "Provider": "Mock",
      "NotifyReceivers": true
    },
    "Outbox": {
      "BatchSize": 25,
      "LockSeconds": 180,
      "MaxAttempts": 5,
      "BaseDelaySeconds": 30,
      "MaxDelaySeconds": 3600,
      "WebhookRetryHours": 24
    }
  },
  "Tracking": {
    "OtpLifetimeMinutes": 10,
    "MaxFailedAttempts": 5,
    "MaxRequestsPerHour": 3,
    "AccessTokenMinutes": 15,
    "PublicBaseUrl": "http://localhost:5173",
    "LogCodes": false
  },
  "Payments": {
    "Mode": "Test",
    "TransactionLifetimeMinutes": 30,
    "TestMerchantName": "Afno Parcel (test merchant)"
  },
  "Delivery": {
    "ProofStoragePath": "storage/proofs",
    "MaxProofSizeKb": 6000,
    "MaxProofsPerAssignment": 5
  },
  "Booking": {
    "VatPercent": 13,
    "VolumetricDivisor": 5000,
    "WeightStepKg": 0.5,
    "MaxWeightKg": 100,
    "MaxDimensionCm": 200,
    "MaxDeclaredValue": 500000,
    "MaxCodAmount": 200000,
    "Receipt": {
      "CompanyName": "Afno Parcel",
      "CompanyPhone": "",
      "CompanyTaxNumber": ""
    }
  },
  "Bootstrap": {
    "SuperAdmin": {
      "Email": "",
      "Password": "",
      "FullName": "Super Admin"
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
