{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedReferenceData": false,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "afno-parcel-api",
    "Audience": "afno-parcel-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "BookingPermitPerMinute": 30,
    "TrackingPermitPerMinute": 60,
    "TrackingOtpPermitPerMinute": 10
  },
  "Tracking": {
    "OtpLifetimeMinutes": 10,
    "MaxFailedAttempts": 5,
    "MaxRequestsPerHour": 3,
    "AccessTokenMinutes": 15,
    "LogCodes": false
  },
  "Booking": {
    "VatPercent": 13,
    "VolumetricDivisor": 5000,
    "WeightStepKg": 0.5,
    "MaxWeightKg": 100,
    "MaxDimensionCm": 200,
    "MaxDeclaredValue": 500000,
    "MaxCodAmount": 200000,
    "Receipt": {
      "CompanyName": "Afno Parcel",
      "CompanyPhone": "",
      "CompanyTaxNumber": ""
    }
  },
  "Bootstrap": {
    "SuperAdmin": {
      "Email": "",
      "Password": "",
      "FullName": "Super Admin"
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
