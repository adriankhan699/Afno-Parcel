# Copy to .env.local for local overrides. Only VITE_* variables are exposed to the browser — no secrets.

# Leave empty to call the API on the same origin (Vite dev proxy / production reverse proxy).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api and /health (dev only, not bundled).
VITE_API_PROXY_TARGET=http://localhost:5080

VITE_APP_NAME=Afno Parcel
